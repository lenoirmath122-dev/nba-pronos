# Copier ce fichier en .env.local et remplir les valeurs (voir README.md).
# Aucune valeur réelle ici -- .env.local n'est jamais commité (.gitignore).

# ── Supabase (obligatoire) ───────────────────────────────────────────────
# En local : valeurs affichées par `npx supabase start` (voir README.md).
# En prod : Project Settings > API sur le dashboard Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role -- contourne la RLS, jamais exposée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# ── Synchro NBA / cron (optionnel en dev) ────────────────────────────────
# Secret partagé (Bearer) qui protège /api/sync/*, /api/heartbeat,
# /api/reminders/*, /api/snapshots/* -- toute valeur suffit en local.
SYNC_SECRET=
# Clé API Highlightly (données NBA officielles) -- requise seulement pour
# tester une route /api/sync/* en local.
HIGHLIGHTLY_API_KEY=

# ── IA (paris personnalisés structurés) ──────────────────────────────────
# Clé API Anthropic (Claude) -- requise pour tester la structuration IA des
# paris personnalisés (lib/ai/structureBet.ts et modules associés).
ANTHROPIC_API_KEY=
# Micro-service Python (Cloud Run) de calcul de probabilités -- optionnel,
# les fonctions predict*() retombent sur "non calculable" si absent.
STATS_SERVICE_URL=
STATS_SERVICE_SECRET=

# ── Notifications push (Web Push / VAPID) ────────────────────────────────
# Générer une paire avec `npx web-push generate-vapid-keys`.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Anti-bot signup (Cloudflare Turnstile) ───────────────────────────────
# Clé "site" publique -- la clé secrète se configure côté dashboard
# Supabase Auth (Auth > Attack protection), pas dans ce fichier.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
