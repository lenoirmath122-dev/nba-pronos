# Copié par install.sh vers /etc/nba-refresh/env (non secret : l'URL Supabase est
# déjà publique dans le front). Les secrets (clé service_role, SYNC_SECRET) ne
# sont JAMAIS ici : run.sh les lit dans Secret Manager.
SUPABASE_URL=https://<ton-projet>.supabase.co
APP_URL=https://nba-pronos.vercel.app
# Poller des résultats NBA (nba-results-poll) et secours de refresh_job.py : 1 (ou
# toute valeur autre que 0/false) = dryRun, la route calcule les écarts sans rien
# écrire. 0 ou false = écriture réelle. install.sh ajoute 1 si la ligne est absente.
RESULTS_POLL_DRYRUN=1
