{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "popup-hebdo/sortie-classifieur-v1",
  "title": "Sortie du classifieur amont de la popup hebdomadaire (v1)",
  "description": "Validé par le code. Échec fermé : tout id absent de la réponse, tout verdict inconnu ou tout JSON invalide vaut « bloqué » (ou brouillon douteux si l'appel entier est inexploitable après 2 retries).",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdicts"],
  "properties": {
    "verdicts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "verdict", "categorie"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][0-9]{1,3}$" },
          "verdict": { "enum": ["ok", "bloque"] },
          "categorie": {
            "enum": [null, "racisme", "discrimination", "manipulation", "doute"]
          }
        },
        "allOf": [
          {
            "if": { "properties": { "verdict": { "const": "ok" } } },
            "then": { "properties": { "categorie": { "const": null } } },
            "else": { "properties": { "categorie": { "type": "string" } } }
          }
        ]
      }
    }
  },
  "x-controles-en-code": [
    "un verdict par id transmis, aucun id inconnu, aucun doublon",
    "un candidat sans verdict est traité comme bloqué"
  ]
}
