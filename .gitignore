# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# maquettes design (hors dépôt — JOURNAL_DESIGN_passe_maquettes.md §3)
/Cadrage/DA/
Cadrage/V1/ecran-matchs-voieA.html

# placeholders de dev du bandeau (§15.7) — jamais committés
public/brand/*.dev.*

# données NBA récupérées via nba_api (volumineux, régénérables) — cf. Cadrage/Stats/
/Cadrage/Stats/data/
# modèles entraînés (volumineux, régénérables via les scripts train_*.py)
/Cadrage/Stats/models/
__pycache__/

# config Claude Code locale à la machine (permissions auto-approuvées, etc.)
.claude/settings.local.json

# e2e (Playwright, C1) : rapports/artefacts + état de session/seed générés
# à chaque run, jamais committés.
/playwright-report/
/test-results/
/e2e/.auth/
/e2e/.e2e-seed.json
